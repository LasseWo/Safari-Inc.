<UserControl x:Class="SafariInc.Views.MerchantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewMouseLeftButtonDown="View_PreviewMouseLeftButtonDown"
             IsVisibleChanged="View_IsVisibleChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Tierliste -->
        <Border Style="{StaticResource Card}" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Deine Tiere" FontSize="22" FontWeight="Bold" Margin="8,4" />
                <TextBlock x:Name="NoAnimalsText" DockPanel.Dock="Top" Style="{StaticResource Hint}"
                           Text="Dein Zoo ist leer. Fang erst ein paar Tiere auf Safari!" />
                <ListBox x:Name="AnimalList" ItemsSource="{Binding Animals}" BorderThickness="0"
                         SelectionChanged="AnimalList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,6">
                                <TextBlock Text="{Binding Species.Emoji}" Style="{StaticResource Emoji}" FontSize="32"
                                           Foreground="{Binding Species.RarityInfo.Color}" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Species.Name}" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock FontSize="13" Foreground="#795548">
                                        <Run Text="{Binding Species.BaseValue, Mode=OneWay}" />
                                        <Run Text="Münzen" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Angebot des Händlers -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <StackPanel x:Name="NoSelection" VerticalAlignment="Center">
                    <TextBlock Text="🧔" Style="{StaticResource Emoji}" FontSize="90" Foreground="#6D4C41" />
                    <TextBlock Text="„Na, was hast du mir mitgebracht?“" FontSize="22" FontStyle="Italic"
                               HorizontalAlignment="Center" Foreground="#6D4C41" />
                </StackPanel>

                <StackPanel x:Name="Offer" Visibility="Collapsed">
                    <TextBlock x:Name="OfferEmoji" Style="{StaticResource Emoji}" FontSize="80" />
                    <TextBlock x:Name="OfferName" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="OfferRarity" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10" />

                    <!-- Bubbling: ein Handler für alle drei Verkaufsarten -->
                    <StackPanel x:Name="Actions" ButtonBase.Click="Actions_Click">
                        <Button Tag="safe" Background="#AED581" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" Style="{StaticResource Emoji}" FontSize="30" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Sicher verkaufen" FontSize="20" />
                                    <TextBlock x:Name="SafeText" FontSize="14" FontWeight="Normal" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Tag="wheel" Background="#FFD54F" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎡" Style="{StaticResource Emoji}" FontSize="30" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Riskieren: Glücksrad drehen" FontSize="20" />
                                    <TextBlock x:Name="WheelText" FontSize="14" FontWeight="Normal" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Tag="shelter" Background="#B3E5FC" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" Style="{StaticResource Emoji}" FontSize="30" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Ans Tierheim abgeben" FontSize="20" />
                                    <TextBlock x:Name="ShelterText" FontSize="14" FontWeight="Normal" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Glücksrad -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <!-- Tabelle und Ergebnis unten fest, das Rad skaliert in den Restplatz -->
                <StackPanel x:Name="PayoutPanel" DockPanel.Dock="Bottom" Visibility="Collapsed">
                    <TextBlock Text="Mögliche Auszahlungen" FontSize="15" FontWeight="Bold" Margin="4,4,4,2" />
                    <ItemsControl x:Name="PayoutTable">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="16" Height="16" RadiusX="4" RadiusY="4" Fill="{Binding Color}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" />
                                    <TextBlock Grid.Column="2" Text="{Binding Chance}" FontSize="15"
                                               Foreground="#795548" />
                                    <TextBlock Grid.Column="3" FontSize="15" FontWeight="Bold" TextAlignment="Right">
                                        <Run Text="{Binding Payout, Mode=OneWay}" />
                                        <Run Text="Münzen" FontWeight="Normal" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock x:Name="WheelResult" DockPanel.Dock="Bottom" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,6"
                           Text="Wer wagt, gewinnt … manchmal." Foreground="#795548" />
                <Viewbox Stretch="Uniform">
                    <Grid Width="320" Height="340">
                        <Canvas x:Name="Wheel" Width="320" Height="320" VerticalAlignment="Bottom">
                            <Canvas.RenderTransform>
                                <RotateTransform x:Name="WheelRotation" CenterX="160" CenterY="160" />
                            </Canvas.RenderTransform>
                        </Canvas>
                        <Ellipse Width="44" Height="44" Fill="#6D4C41" Stroke="White" StrokeThickness="4"
                                 VerticalAlignment="Bottom" Margin="0,0,0,138" />
                        <!-- Zeiger -->
                        <Polygon Points="0,0 36,0 18,40" Fill="#3E2723" Stroke="White" StrokeThickness="3"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" />
                    </Grid>
                </Viewbox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
