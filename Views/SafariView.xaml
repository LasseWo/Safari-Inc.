<UserControl x:Class="SafariInc.Views.SafariView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SafariInc.Views">
    <Grid>
        <!-- 1. Köder auswählen -->
        <!-- Bubbling: Alle Kaufen-/Safari-Buttons der Karten landen in EINEM Handler -->
        <ItemsControl x:Name="BaitPanel" ItemsSource="{Binding Baits}" ButtonBase.Click="BaitList_Click"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="BaitIcon" Text="{Binding Info.Emoji}" Style="{StaticResource Emoji}"
                                       FontSize="96" Foreground="#D84315" />
                            <TextBlock Text="{Binding Info.Stars}" Style="{StaticResource Stars}" Foreground="#FFB300" />
                            <!-- Vorrat als Bilder: drei Köder = drei Bilder -->
                            <TextBlock Text="{Binding StockIcons}" Style="{StaticResource Emoji}" FontSize="28"
                                       Foreground="#D84315" Height="44" Margin="0,4" />
                            <Button x:Name="BuyButton" Tag="buy" Background="#FFE082" Height="64" FontSize="26"
                                    AutomationProperties.Name="{Binding Info.Name, StringFormat='{}{0} kaufen'}"
                                    views:Attention.Pulse="{Binding PulseBuy}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" Style="{StaticResource Emoji}" Margin="0,0,12,0"
                                               VerticalAlignment="Center" />
                                    <ContentControl Content="{Binding Info.Price}"
                                                    ContentTemplate="{StaticResource CoinAmount}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HuntButton" Tag="hunt" Background="#7CB342" Foreground="White" Height="96"
                                    AutomationProperties.Name="{Binding Info.Name, StringFormat='Safari mit {0}'}"
                                    views:Attention.Pulse="{Binding PulseHunt}">
                                <TextBlock Text="🚙" Style="{StaticResource Emoji}" FontSize="60" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Count}" Value="0">
                            <Setter TargetName="BaitIcon" Property="Opacity" Value="0.3" />
                        </DataTrigger>
                        <!-- Abgedunkelt = geht gerade nicht. Der Klick bleibt möglich und gibt Rückmeldung. -->
                        <DataTrigger Binding="{Binding CanAfford}" Value="False">
                            <Setter TargetName="BuyButton" Property="Opacity" Value="0.4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CanHunt}" Value="False">
                            <Setter TargetName="HuntButton" Property="Opacity" Value="0.35" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 2. + 3. Safari und Tier erraten -->
        <Grid x:Name="HuntPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="170" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border CornerRadius="18" ClipToBounds="True" Margin="10,0">
                <Canvas x:Name="Landscape" ClipToBounds="True">
                    <Canvas.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#81D4FA" Offset="0" />
                            <GradientStop Color="#FFE0B2" Offset="0.62" />
                            <GradientStop Color="#C5A05A" Offset="0.63" />
                            <GradientStop Color="#A1887F" Offset="1" />
                        </LinearGradientBrush>
                    </Canvas.Background>
                    <Ellipse Width="70" Height="70" Fill="#FFEB3B" Canvas.Left="60" Canvas.Top="14" />
                    <TextBlock Text="🌳" Style="{StaticResource Emoji}" FontSize="64" Foreground="#2E7D32"
                               Canvas.Left="220" Canvas.Top="30" />
                    <TextBlock Text="🌴" Style="{StaticResource Emoji}" FontSize="72" Foreground="#388E3C"
                               Canvas.Left="520" Canvas.Top="20" />
                    <TextBlock Text="🌳" Style="{StaticResource Emoji}" FontSize="54" Foreground="#2E7D32"
                               Canvas.Left="820" Canvas.Top="42" />
                    <TextBlock x:Name="Jeep" Text="🚙" Style="{StaticResource Emoji}" FontSize="60"
                               Foreground="#E65100" Canvas.Top="84">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="JeepShift" X="-200" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <!-- Während der Fahrt: Spuren im Sand -->
                    <TextBlock x:Name="DrivingText" Text="🐾 🐾 🐾" Style="{StaticResource Emoji}" FontSize="72"
                               Foreground="#A1887F" VerticalAlignment="Center" views:Attention.Pulse="True" />

                    <DockPanel x:Name="GuessArea" Visibility="Collapsed">
                        <!-- Hören + Zeit -->
                        <DockPanel x:Name="QuestionRow" DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Left" Click="Replay_Click" Background="#B3E5FC" Width="120"
                                    Height="64" AutomationProperties.Name="Geräusch nochmal hören">
                                <TextBlock Text="🔊" Style="{StaticResource Emoji}" FontSize="38" />
                            </Button>
                            <TextBlock Text="⏳" Style="{StaticResource Emoji}" FontSize="30" Foreground="#FB8C00"
                                       VerticalAlignment="Center" Margin="12,0,8,0" />
                            <ProgressBar x:Name="TimeBar" Height="24" Maximum="1" Value="1" VerticalAlignment="Center"
                                         Foreground="#FB8C00" Background="#FFE0B2" BorderThickness="0" />
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Silhouette wird mit der Zeit schärfer -->
                            <Viewbox>
                                <TextBlock x:Name="Silhouette" Style="{StaticResource Emoji}" FontSize="150"
                                           Foreground="#4E342E" Padding="10">
                                    <TextBlock.Effect>
                                        <BlurEffect x:Name="SilhouetteBlur" Radius="40" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Viewbox>

                            <ItemsControl x:Name="GuessList" Grid.Column="1" ButtonBase.Click="GuessList_Click">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" Rows="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="#FFF3E0" Margin="8" Padding="8,4" BorderBrush="#FFB74D"
                                                BorderThickness="3" AutomationProperties.Name="{Binding Name}">
                                            <Viewbox>
                                                <TextBlock Text="{Binding Emoji}" Style="{StaticResource Emoji}"
                                                           FontSize="80" Foreground="{Binding Color}" />
                                            </Viewbox>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Ergebnis nur mit Bildern: Haken/Kreuz, Sterne, was passiert ist, weiter -->
                            <StackPanel x:Name="ResultPanel" Grid.Column="1" Visibility="Collapsed"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="ResultIcon" Style="{StaticResource Emoji}" FontSize="96"
                                               VerticalAlignment="Center" Margin="0,0,30,0" />
                                    <TextBlock x:Name="ResultPicture" Style="{StaticResource Emoji}" FontSize="64"
                                               Foreground="#6D4C41" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ResultStars" Style="{StaticResource Stars}" FontSize="36"
                                           Margin="0,0,0,12" />
                                <Button Click="Continue_Click" AutomationProperties.Name="Weiter" Background="#7CB342"
                                        Foreground="White" Width="240" Height="88" views:Attention.Pulse="True">
                                    <Polygon Points="0,0 44,26 0,52" Fill="White" Stroke="White"
                                             StrokeThickness="4" StrokeLineJoin="Round" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
