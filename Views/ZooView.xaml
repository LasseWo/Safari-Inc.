<UserControl x:Class="SafariInc.Views.ZooView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SafariInc.Views"
             IsVisibleChanged="View_IsVisibleChanged">
    <UserControl.Resources>
        <!-- Stationen auf der Karte: Hierhin zieht man die Tiere -->
        <Style x:Key="Station" TargetType="Border">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="170" />
            <Setter Property="CornerRadius" Value="30" />
            <Setter Property="BorderThickness" Value="6" />
            <Setter Property="BorderBrush" Value="{StaticResource Wood}" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.35" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StationIcon" TargetType="TextBlock" BasedOn="{StaticResource Emoji}">
            <Setter Property="FontSize" Value="76" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <!-- Zeigt beim Ziehen, was das Tier an dieser Station bringt -->
        <Style x:Key="StationHint" TargetType="TextBlock" BasedOn="{StaticResource Emoji}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Visibility" Value="Hidden" />
        </Style>
    </UserControl.Resources>

    <!-- Die Karte hat feste Koordinaten. Die Viewbox skaliert sie passend ins Fenster. -->
    <Viewbox Stretch="Uniform">
        <!-- Tunneling: Die Preview-Handler sehen die Maus vor den Gehege-Buttons und erkennen so das Ziehen -->
        <Canvas x:Name="Map" Width="1160" Height="640"
                PreviewMouseLeftButtonDown="Map_PreviewMouseLeftButtonDown"
                PreviewMouseMove="Map_PreviewMouseMove"
                PreviewMouseLeftButtonUp="Map_PreviewMouseLeftButtonUp"
                LostMouseCapture="Map_LostMouseCapture">
            <Canvas.Clip>
                <RectangleGeometry Rect="0,0,1160,640" RadiusX="28" RadiusY="28" />
            </Canvas.Clip>
            <Canvas.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#AED581" Offset="0" />
                    <GradientStop Color="#8BC34A" Offset="1" />
                </LinearGradientBrush>
            </Canvas.Background>

            <!-- Landschaft -->
            <Path Data="M-30,316 C180,282 380,352 600,316 S800,284 900,312 S1060,348 1190,306"
                  Stroke="#EAD9AE" StrokeThickness="54" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Canvas.Left="770" Canvas.Top="212" Width="130" Height="62" Fill="#81D4FA"
                     Stroke="#4FC3F7" StrokeThickness="4" />
            <TextBlock Text="🌳" Style="{StaticResource Emoji}" FontSize="50" Foreground="#2E7D32"
                       Canvas.Left="4" Canvas.Top="236" />
            <TextBlock Text="🌴" Style="{StaticResource Emoji}" FontSize="56" Foreground="#2E7D32"
                       Canvas.Left="470" Canvas.Top="234" />
            <TextBlock Text="🌳" Style="{StaticResource Emoji}" FontSize="48" Foreground="#2E7D32"
                       Canvas.Left="240" Canvas.Top="340" />
            <TextBlock Text="🌴" Style="{StaticResource Emoji}" FontSize="52" Foreground="#2E7D32"
                       Canvas.Left="1060" Canvas.Top="20" />
            <TextBlock Text="🌳" Style="{StaticResource Emoji}" FontSize="46" Foreground="#2E7D32"
                       Canvas.Left="800" Canvas.Top="540" />
            <TextBlock Text="🌴" Style="{StaticResource Emoji}" FontSize="72" Foreground="#2E7D32"
                       Canvas.Left="1020" Canvas.Top="470" />

            <!-- Gehege. Bubbling: Ein Click-Handler für alle -->
            <ItemsControl x:Name="PenList" ItemsSource="{Binding Enclosures}" Width="1160" Height="640"
                          ButtonBase.Click="Enclosures_Click">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding MapSpot.X}" />
                        <Setter Property="Canvas.Top" Value="{Binding MapSpot.Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Pen" Width="220" Height="200" Margin="0" Padding="0"
                                BorderBrush="{StaticResource Wood}" BorderThickness="7"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Number, StringFormat='Gehege {0}'}"
                                views:Attention.Pulse="{Binding PulseBuy}">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F1F8E9" Offset="0" />
                                    <GradientStop Color="#C5E1A5" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <Grid>
                                <!-- belegt: Das Tier läuft herum und lässt sich herausziehen -->
                                <Grid x:Name="AnimalView" Visibility="Collapsed" Background="Transparent">
                                    <StackPanel VerticalAlignment="Center" views:Attention.Wander="True">
                                        <TextBlock Text="{Binding Animal.Species.Emoji}" Style="{StaticResource Emoji}"
                                                   FontSize="92" Foreground="{Binding Animal.Species.Color}" />
                                        <TextBlock Text="{Binding Animal.Species.RarityInfo.Stars}"
                                                   Style="{StaticResource Stars}"
                                                   Foreground="{Binding Animal.Species.RarityInfo.Color}" />
                                    </StackPanel>
                                    <!-- geduscht -->
                                    <TextBlock Text="✨" Style="{StaticResource Emoji}" FontSize="36" Foreground="#FFA000"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,10,0"
                                               Visibility="{Binding Animal.IsClean, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <!-- frei -->
                                <TextBlock x:Name="EmptyView" Text="🐾" Style="{StaticResource Emoji}" FontSize="72"
                                           Foreground="#689F38" Opacity="0.6" VerticalAlignment="Center"
                                           Visibility="Collapsed" />

                                <!-- gesperrt -->
                                <StackPanel x:Name="LockedView" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="🔒" Style="{StaticResource Emoji}" FontSize="64" Foreground="#616161" />
                                    <ContentControl Content="{Binding Price}" ContentTemplate="{StaticResource CoinAmount}"
                                                    FontSize="28" HorizontalAlignment="Center" Foreground="#424242" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="False">
                                <Setter TargetName="AnimalView" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsEmpty}" Value="True" />
                                    <Condition Binding="{Binding IsUnlocked}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="EmptyView" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                <Setter TargetName="LockedView" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Pen" Property="Background" Value="#E0E0E0" />
                                <Setter TargetName="Pen" Property="BorderBrush" Value="#9E9E9E" />
                            </DataTrigger>
                            <!-- Dieses Gehege kann man jetzt kaufen: es leuchtet -->
                            <DataTrigger Binding="{Binding CanBuy}" Value="True">
                                <Setter TargetName="Pen" Property="Background" Value="#FFE082" />
                                <Setter TargetName="Pen" Property="BorderBrush" Value="{StaticResource Wood}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Stationen. Die Tags benutzt ZooView.xaml.cs beim Ablegen. -->
            <Border x:Name="StationShower" Tag="shower" Style="{StaticResource Station}" Background="#B3E5FC"
                    Canvas.Left="800" Canvas.Top="30">
                <StackPanel>
                    <TextBlock Text="🚿" Style="{StaticResource StationIcon}" />
                    <TextBlock x:Name="ShowerHint" Style="{StaticResource StationHint}" Foreground="#D84315" />
                </StackPanel>
            </Border>
            <Border x:Name="StationSell" Tag="sell" Style="{StaticResource Station}" Background="#AED581"
                    Canvas.Left="985" Canvas.Top="190">
                <StackPanel>
                    <TextBlock Text="💰" Style="{StaticResource StationIcon}" />
                    <TextBlock x:Name="SellHint" Style="{StaticResource StationHint}" />
                </StackPanel>
            </Border>
            <Border x:Name="StationWheel" Tag="wheel" Style="{StaticResource Station}" Background="#FFD54F"
                    Canvas.Left="800" Canvas.Top="345">
                <StackPanel>
                    <TextBlock Text="🎡" Style="{StaticResource StationIcon}" />
                    <TextBlock x:Name="WheelHint" Style="{StaticResource StationHint}" />
                </StackPanel>
            </Border>

            <!-- Zeigt ohne Worte, wie das Ziehen geht: Eine Hand trägt ein Tier zur Station -->
            <StackPanel x:Name="DragHint" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="DragHintAnimal" Style="{StaticResource Emoji}" FontSize="70" />
                <TextBlock Text="👆" Style="{StaticResource Emoji}" FontSize="64" Foreground="{StaticResource Ink}"
                           Margin="0,-26,0,0" />
            </StackPanel>

            <!-- Das Tier an der Maus, während es gezogen wird -->
            <TextBlock x:Name="Ghost" Style="{StaticResource Emoji}" FontSize="84" Visibility="Collapsed"
                       IsHitTestVisible="False" />
        </Canvas>
    </Viewbox>
</UserControl>
