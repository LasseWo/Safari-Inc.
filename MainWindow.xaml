<Window x:Class="SafariInc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SafariInc.Views"
        Title="Safari Inc. – Das Glück gehört dem Händler"
        Width="1200" Height="800" MinWidth="1050" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Sand}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: Titel + Inventar -->
        <Border Grid.Row="0" Background="{StaticResource SafariGreen}" Padding="18,10" Panel.ZIndex="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="🚙" Style="{StaticResource Emoji}" FontSize="36" Foreground="#FFD54F"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Safari Inc." FontSize="28" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Das Glück gehört dem Händler" FontSize="13" FontStyle="Italic"
                                   Foreground="#C5E1A5" />
                    </StackPanel>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="Neues Spiel" Click="NewGame_Click"
                        Background="#8D6E63" Foreground="White" FontSize="14" VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <ItemsControl ItemsSource="{Binding Baits}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#22FFFFFF" CornerRadius="10" Padding="10,4" Margin="4,0"
                                        ToolTip="{Binding Info.Name}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Info.Emoji}" Style="{StaticResource Emoji}"
                                                   FontSize="20" Foreground="#FFCC80" />
                                        <TextBlock Text="{Binding Count}" FontSize="20" FontWeight="Bold"
                                                   Foreground="White" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="16,0,0,0">
                        <Border Background="#FFD54F" CornerRadius="12" Padding="14,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🪙" Style="{StaticResource Emoji}" FontSize="22"
                                           Foreground="#E65100" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Coins}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource Ink}" Margin="8,0,0,0" MinWidth="50"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- schwebende +/- Anzeige bei CurrencyChanged -->
                        <TextBlock x:Name="CoinDelta" FontSize="22" FontWeight="Bold" Opacity="0"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CoinDeltaShift" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigation: EIN Click-Handler für alle Buttons (Bubbling),
             EIN Preview-Handler, der Klicks während einer Safari blockiert (Tunneling) -->
        <Border Grid.Row="1" Background="{StaticResource SafariGreen}" BorderBrush="#1B5E20"
                BorderThickness="0,1,0,0">
            <StackPanel x:Name="NavBar" Orientation="Horizontal" HorizontalAlignment="Center"
                        ButtonBase.Click="NavBar_Click"
                        PreviewMouseLeftButtonDown="NavBar_PreviewMouseLeftButtonDown">
                <Button Style="{StaticResource NavButton}" Tag="Safari">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌴" Style="{StaticResource Emoji}" Margin="0,0,8,0" />
                        <TextBlock Text="Safari" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="Zoo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏞" Style="{StaticResource Emoji}" Margin="0,0,8,0" />
                        <TextBlock Text="Zoo" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource NavButton}" Tag="Merchant">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💰" Style="{StaticResource Emoji}" Margin="0,0,8,0" />
                        <TextBlock Text="Händler" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Die Views bleiben im Baum (nur ausgeblendet), damit ihre Events
             immer bis zum Fenster hochblubbern können. -->
        <Grid Grid.Row="2" Margin="12">
            <views:SafariView x:Name="SafariPage" />
            <views:ZooView x:Name="ZooPage" Visibility="Collapsed" />
            <views:MerchantView x:Name="MerchantPage" Visibility="Collapsed" />
        </Grid>

        <!-- Statuszeile für GameMessage -->
        <Border Grid.Row="3" x:Name="StatusBar" Background="#C8E6C9" Padding="18,10">
            <TextBlock x:Name="StatusText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource Ink}"
                       Text="Willkommen bei Safari Inc.! Wähle einen Köder und fahr auf Safari." />
        </Border>
    </Grid>
</Window>
