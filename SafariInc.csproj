<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <!-- Echte Tiergeräusche: Sounds\<tier-id>.wav, z. B. Sounds\loewe.wav -->
    <None Update="Sounds\**\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
